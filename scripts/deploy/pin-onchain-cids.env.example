# Copy to /etc/nexus/pin-onchain-cids.env and adjust paths/secrets.
# cp scripts/deploy/pin-onchain-cids.env.example /etc/nexus/pin-onchain-cids.env

# Chain RPC (prefer internal endpoint in production)
WS_URL=wss://rpc.nexusmall.net

# IPFS pin API (required for pin timer/service)
PIN_ENDPOINT=https://ipfs.internal.example/api/v0/pin/add
PIN_TOKEN=

# Loop: fast query + registry pin every 5 minutes (default)
PIN_INTERVAL_MINUTES=5
PIN_TIMEOUT_MS=30000
PIN_RETRIES=2
PIN_CONCURRENCY=4
SCAN_CONCURRENCY=8
FAIL_ON_PIN_ERRORS=1

# Optional webhook for pin failures (Slack/Discord/custom). Body: JSON summary snippet.
# ALERT_WEBHOOK_URL=https://hooks.example.com/nexus-pin-alert

# Output paths (ensure directory exists and service user can write)
CID_OUTPUT_FILE=/var/log/nexus/pin-onchain-cids.json
CID_QUERY_OUTPUT_FILE=/var/log/nexus/query-onchain-cids.json

# Do NOT set in production unless you understand the risk:
# INSECURE_TLS=1
