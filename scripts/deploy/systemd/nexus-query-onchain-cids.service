[Unit]
Description=Nexus on-chain IPFS CID audit query (default pallet whitelist)
Documentation=file:///opt/nexus/scripts/e2e/mytests/pin-onchain-cids.ts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nexus
Group=nexus
WorkingDirectory=/opt/nexus/scripts
EnvironmentFile=-/etc/nexus/pin-onchain-cids.env
Environment=CID_OUTPUT_FILE=/var/log/nexus/query-onchain-cids.json
ExecStart=/usr/bin/node --import tsx e2e/mytests/pin-onchain-cids.ts --dry-run --once --scan-mode fast --no-fail-on-error
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexus-query-onchain-cids

[Install]
WantedBy=multi-user.target
