{
  "name": "nexus-test-scripts",
  "version": "3.0.0",
  "description": "Nexus runtime smoke and contract tests",
  "type": "module",
  "scripts": {
    "e2e": "node --import tsx e2e/run.ts",
    "e2e:list": "node --import tsx e2e/run.ts --list",
    "e2e:contracts": "node --import tsx e2e/run.ts --suite runtime-contracts",
    "e2e:smoke": "node --import tsx e2e/run.ts --suite chain-health entity-lifecycle nex-market-smoke",
    "e2e:entity:buyer": "node --import tsx e2e/run.ts --suite entity-smoke-buyer-core-flow",
    "e2e:entity:seller": "node --import tsx e2e/run.ts --suite entity-smoke-seller-core-flow",
    "e2e:entity:commission": "node --import tsx e2e/run.ts --suite entity-smoke-commission-core-flow",
    "e2e:entity:governance": "node --import tsx e2e/run.ts --suite entity-smoke-governance-core-flow",
    "e2e:governance:proposal-vote-execute": "node --import tsx e2e/run.ts --suite governance-proposal-vote-execute",
    "e2e:commission:multi-level": "node --import tsx e2e/run.ts --suite commission-multi-level-basic",
    "e2e:commission:withdrawal": "node --import tsx e2e/run.ts --suite commission-withdrawal-split",
    "e2e:compliance:token-blackout": "node --import tsx e2e/run.ts --suite compliance-blackout-token-restriction",
    "e2e:compliance:market-blackout": "node --import tsx e2e/run.ts --suite compliance-blackout-market-restriction",
    "e2e:entity:market": "node --import tsx e2e/run.ts --suite entity-smoke-market-core-flow",
    "e2e:entity:smoke": "node --import tsx e2e/run.ts --suite entity-smoke-buyer-core-flow entity-smoke-seller-core-flow entity-smoke-commission-core-flow entity-smoke-governance-core-flow entity-smoke-market-core-flow",
    "e2e:phase1": "node --import tsx e2e/run.ts --suite phase1-service-order-lifecycle phase1-third-party-payment-order phase1-token-payment-token-commission phase1-buy-order-acceptance-flow phase1-spend-driven-level-upgrade phase1-shop-closing-guard-cancel",
    "e2e:remote": "node --import tsx e2e/remote.ts",
    "e2e:remote:list": "node --import tsx e2e/remote.ts --list",
    "e2e:remote:contracts": "node --import tsx e2e/remote.ts --suite runtime-contracts",
    "e2e:remote:inspect": "node --import tsx e2e/inspect-remote.ts",
    "e2e:remote:debug-transfer": "node --import tsx e2e/debug-transfer-remote.ts",
    "e2e:remote:smoke:write": "node --import tsx e2e/remote.ts --suite entity-lifecycle nex-market-smoke",
    "e2e:typecheck": "tsc --noEmit",
    "query:genesis-inscription": "POLKADOTJS_DISABLE_ESM_CJS_WARNING=1 node query-genesis-inscription.js",
    "test:commission": "node --import tsx e2e/mytests/trace-commission-flow.ts",
    "setup:entity": "node --import tsx e2e/mytests/setup-entity-full.ts",
    "setup:two-entities": "node --import tsx e2e/mytests/create-two-entities-from-json.ts",
    "test:bulk-orders": "node --import tsx e2e/mytests/random-bulk-orders.ts",
    "test:upgrade-referral": "node --import tsx e2e/mytests/upgrade-via-referral-chain.ts",
    "test:pool-reward": "node --import tsx e2e/mytests/test-pool-reward-claim.ts",
    "test:pool-reward:query": "SKIP_CLAIM=1 node --import tsx e2e/mytests/test-pool-reward-claim.ts",
    "query:pool-reward-stats": "node --import tsx e2e/mytests/pool-reward-stats.ts",
    "query:validator-staking": "node --import tsx e2e/mytests/validator-staking-audit.ts",
    "payout:validator-staking": "node --import tsx e2e/mytests/validator-staking-payout.ts",
    "query:onchain-cids": "node --import tsx e2e/mytests/pin-onchain-cids.ts --dry-run --once --scan-mode fast",
    "query:onchain-cids:full": "node --import tsx e2e/mytests/pin-onchain-cids.ts --dry-run --once --full-scan",
    "query:onchain-cids:all": "node --import tsx e2e/mytests/pin-onchain-cids.ts --dry-run --once --scan-mode all",
    "pin:onchain-cids": "node --import tsx e2e/mytests/pin-onchain-cids.ts",
    "pin:onchain-cids:once": "node --import tsx e2e/mytests/pin-onchain-cids.ts --once"
  },
  "dependencies": {
    "@polkadot/api": "^16.5.4",
    "@polkadot/keyring": "^14.0.1",
    "@polkadot/util": "^14.0.1",
    "@polkadot/util-crypto": "^14.0.1",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
