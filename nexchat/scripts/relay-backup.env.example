# EN: Environment for relay-backup-to-ipfs.sh / relay-backup-run.sh
# CN: Relay IPFS 备份环境变量（复制到 relay-ops/relay-backup.env 或 /opt/nexchat-relay/relay-backup.env）
#
# Quick setup: ./scripts/relay-ops-init.sh

# --- paths ---
RELAY_DATA_DIR=/opt/nexchat-relay/data
BACKUP_LATEST_FILE=/opt/nexchat-relay/latest-backup.json
BACKUP_LOCAL_DIR=/opt/nexchat-relay/backups

# --- encryption (pick one) ---
BACKUP_ENCRYPT=gpg
GPG_PASSPHRASE_FILE=/opt/nexchat-relay/backup.pass
# BACKUP_ENCRYPT=age
# AGE_RECIPIENT=age1...

# --- IPFS ---
IPFS_API=http://127.0.0.1:5001
IPFS_PIN=1
BACKUP_KEEP_LOCAL=5

# --- relay lifecycle (recommended in production) ---
BACKUP_STOP_RELAY=1
RELAY_STOP_CMD=systemctl stop nexchat-relay
RELAY_START_CMD=systemctl start nexchat-relay

# --- off-host manifest copy (ADR CHAT_SYNC_ANCHOR §4.2; $1 = manifest path) ---
# BACKUP_OFFSITE_CMD='scp "$1" backup@offsite:/srv/relay/latest-backup.json'

# --- restore script uses the same env + ---
# GPG_PASSPHRASE_FILE or AGE_IDENTITY_FILE

# --- §5.8 acceptance audit (relay-sync-audit.mjs) ---
# IPFS_GATEWAYS=https://gw1.example/ipfs,https://gw2.example/ipfs   # >=2 independent
# AUDIT_MIN_GATEWAYS=2
# AUDIT_IPFS_API=http://10.0.0.2:5001        # hot-tier pinner node (PINNER_IPFS_API fallback)
# CRUST_PINNER_STATE_FILE=/opt/nexchat-relay/data/relay-crust-pinner-state.json
# CRUST_PIN_ENDPOINT=http://10.0.0.3:3000/psa  # optional live order status
# CRUST_PIN_TOKEN=...
# AUDIT_ALLOW_SKIP=1                          # dev only; production must run all three
