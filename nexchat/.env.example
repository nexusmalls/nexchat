# Nexus node WebSocket (Polkadot.js ApiPromise)
VITE_WS_ENDPOINT=ws://127.0.0.1:9944

# HTTP JSON-RPC endpoint for chat_* methods.
# Local dev: use /chain-rpc (Vite proxies to :9944, avoids CORS without --rpc-cors=all).
# Production / LAN: full URL, e.g. https://rpc.example.com or http://192.168.1.10:9944
VITE_HTTP_ENDPOINT=/chain-rpc

# Optional MLS relay WebSocket (leave empty = BroadcastChannel only; cross-machine needs WS).
# Local: npm run relay:server  →  ws://127.0.0.1:8765
# Remote VPS example: ws://151.158.134.181:8765
VITE_RELAY_WS=

# Match relay RELAY_STRICT_AUTH=1 — attach account_sig on register_account (default false).
# 与 relay RELAY_STRICT_AUTH=1 对齐——register_account 附带 account_sig（默认 false）。
# VITE_RELAY_STRICT_AUTH=true

# Use mock conversation data (true = UI demo, false = live chain RPC)
VITE_USE_MOCK=true

# Enable OpenMLS WASM encryption on relay frames (requires session init)
VITE_MLS_ENABLED=true

# dApp display name (shown if a Polkadot.js extension is used elsewhere — NOT the production wallet path).
# dApp 显示名（仅在别处使用 Polkadot.js 扩展时出现——非生产钱包路径）。
VITE_APP_NAME=NexChat

# Live-mode read-only account when VITE_USE_MOCK=false (default //Bob dev account)
VITE_DEV_ADDRESS=5FHneW46xGXgs5mUiveU4sbTyGBzmstUspZC92UhjJM694ty

# Crypto backend for the demo group: "openmls" (real RFC 9420 WASM) or "webcrypto"
# (AES-GCM placeholder). Other conversations always use webcrypto for now.
VITE_MLS_BACKEND=openmls

# Group id the relay-handshake OpenMLS demo binds to (relay control-plane only).
VITE_MLS_DEMO_GROUP=0

# 1:1 Wire multi-leaf (HYBRID_DESIGN §4 / CHAT_1TO1_WIRE_COMMIT_SERIALIZATION_SPEC). Default OFF.
# When true, direct (1:1) chats run on a SEPARATE device-distinct OpenMLS engine ({account}#{device})
# with Gate-1/2 commit serialization + E2EI in-MLS leaf binding → per-device add/remove + multi-device
# 1:1. Privacy trade-off (disclosed in-app, H5): peers can see ~how many devices you have. Group
# (Track A) chats are unaffected. Requires a relay that supports peer_add_req / commit-slot CAS /
# mls_backlog_req. Enabled in .env.production.
# VITE_WIRE_MULTILEAF_ENABLED=false
# 1:1 X3DH + Double Ratchet (CHAT_1TO1_X3DH_DOUBLE_RATCHET_DESIGN §20). Default ON when VITE_RELAY_WS
# is set — preferred 1:1 stack; MLS-Wire (`VITE_WIRE_MULTILEAF_ENABLED`) remains fallback for legacy
# peers. Set VITE_DR_ENABLED=false to disable. Requires relay + pallet-msg-identity on chain.
# VITE_DR_ENABLED=true
# Group Wire multi-leaf (CHAT_GROUP_WIREIFY_DESIGN §17). Default OFF. When true (with 1:1 Wire on),
# groups use per-device leaf on gwire:{account}; retires Track A group read-only/handoff. ON in
# .env.production. Requires relay device_join_* / peer_add_req / group Welcome routing.
# VITE_WIRE_GROUP_MULTILEAF_ENABLED=false
# Delete undecryptable mailbox frames via chat_consume (ops / single-device only; default OFF).
# 删除无法解密的邮箱帧（运维/单设备可选；默认关闭，多设备勿开）。
# VITE_CHAT_MAILBOX_CONSUME_STALE=false

# Track A encrypted MLS state-escrow vault sync (CHAT_MULTIDEVICE_MLS_SYNC §4/§13). Default ON
# (opt-out): full devices escrow signature-key-stripped group MLS state → IPFS → relay/chain pointer;
# cold/swapped devices restore READ-ONLY group state then obtain sending authority via online handoff
# (§5). Requires IPFS. Set to false to disable.
# VITE_MLS_VAULT_ENABLED=true

# Track A PIN-wrapped signing-key backup (§5.3 path C). DEFAULT OFF — requires vault + IPFS.
# VITE_MLS_SIGNING_PIN_BACKUP=false

# Handshake control-plane: "chain" = REAL on-chain DS/AS (publish_key_package / commit /
# pending_welcome); "relay" = BroadcastChannel simulation. Default: relay when VITE_USE_MOCK
# =true, else chain. The chain plane needs a running node and signs with a dev keyring seed.
VITE_MLS_CONTROL_PLANE=chain

# This tab's dev signer seed for the chain control-plane (no wallet extension). A `?as=//Bob`
# URL query overrides this, so two browser tabs can each drive a distinct on-chain identity.
VITE_DEV_SEED=//Alice

# Demo roster seeds (comma-separated); roster[0] is the group owner (it funds the others and
# mints/commits the group). Owner should be a funded account (e.g. //Alice on --dev).
# Production (.env.production): leave empty (VITE_MLS_ROSTER=) so dev demo seeds are not injected.
# Dev roster addresses are still auto-added as saved contacts on unlock; labels prefer on-chain
# chat nicknames (fallback: seed name, then short address).
VITE_MLS_ROSTER=//Alice,//Bob,//Charlie
# Comma-separated SS58 default friends (production-friendly). Auto-added on unlock if missing;
# display names from on-chain nickname. Merges with mlsRosterSeeds-derived addresses when set.
# VITE_DEFAULT_CONTACTS=

# IPFS — local kubo (API :5001, gateway :8080). Vite dev proxies /ipfs-api and /ipfs-gateway.
# Set VITE_IPFS_ENABLED=false to hide attach/avatar upload UI.
VITE_IPFS_ENABLED=true
VITE_IPFS_API_URL=/ipfs-api
VITE_IPFS_GATEWAY_URL=/ipfs-gateway
# Chunk when size > threshold (bytes) or mime is video; 1 MiB chunks by default.
VITE_IPFS_CHUNK_THRESHOLD=16777216
VITE_IPFS_CHUNK_SIZE=1048576
VITE_IPFS_THUMB_MAX_PX=320
# Optional on-chain Pin after upload (costs balance; skipped for ephemeral attachments).
VITE_IPFS_PIN_ENABLED=false
# Sender local kubo pin for chat media (not chain/global). Ephemeral uploads always skip pin.
# Sync blobs (conv-index / contacts / archive) always pin locally regardless of this flag.
VITE_IPFS_MEDIA_LOCAL_PIN=true
# Local pin TTL in ms before best-effort unpin (default 30 days). Set 0 to disable TTL tracking.
VITE_IPFS_MEDIA_LOCAL_PIN_TTL_MS=2592000000
# Encrypted conv-index blob sync (IPFS + relay pointer) for cross-device session discovery.
VITE_CONV_INDEX_ENABLED=true
# Encrypted contact-book vault sync (IPFS + relay contacts_put/fetch) for cross-device roster.
VITE_CONTACTS_VAULT_ENABLED=true
# Encrypted message-history archive sync (IPFS + relay msg_archive_put/fetch) for cross-device timelines.
VITE_MSG_ARCHIVE_ENABLED=true
# Max non-ephemeral messages per conversation in each archive blob push.
VITE_MSG_ARCHIVE_MAX_PER_CONV=500
# --- EISA on-chain encrypted sync anchor (ADR CHAT_SYNC_ANCHOR §7/§11) ---
# Default tier: "standard" = publish encrypted anchor on the long debounce;
# "relay_only" = never touch the chain (zero anchor metadata on-chain; per-account
# user toggle in Settings → Data overrides this default).
VITE_SYNC_ANCHOR_DEFAULT=standard
# Client long debounce for publish_sync_anchor in ms (chain hard cap is
# MinBlocksBetweenPublish; the stricter wins). Production ≥ 900000 (15min).
VITE_SYNC_ANCHOR_DEBOUNCE_MS=900000
# Extrinsic payer (P3 unlinking): "main" = primary account pays (fee link disclosed);
# "burner" = dedicated vault_master-derived payer account (one-time funding transfer
# remains visible; per-publish trail moves off the main account).
VITE_SYNC_ANCHOR_PAYER=main
# RFC 9474 blind delivery tokens for 1:1 direct (relay verifies + spent set).
VITE_DELIVERY_TOKENS_ENABLED=true
# RSA modulus bits for inbox IPK (3072 per design; 2048 for faster local dev).
VITE_DELIVERY_RSA_MODULUS=3072
# Blind tokens per token_req batch (8 = faster first message; default was 24).
VITE_DELIVERY_TOKEN_BATCH=8
# Dev-only //Seed keyring shortcut on the welcome screen (VITE_DEV_WALLET=true).
# Production uses the built-in desktop wallet (WalletGate); set false to hide the dev button only.
# 欢迎页 dev //Seed 快捷入口（VITE_DEV_WALLET=true）。生产用内置桌面钱包（WalletGate）；
# 设为 false 仅隐藏 dev 按钮，并非改用扩展钱包。详见 docs/WALLET.md。
VITE_DEV_WALLET=true

# --- Relay server (systemd / Rust relay-rs — not Vite) ---
# RELAY_PORT=8765
# RELAY_DATA_DIR=/opt/nexchat-relay/data
# RELAY_ADMIN_SECRET=...                 # required for admin_stats from non-localhost
# RELAY_MAX_MSG_BYTES=262144
# RELAY_RATE_LIMIT=120
# RELAY_SPENT_CAP=50000
# Offline chat mailbox (store-and-forward ciphertext):
# RELAY_CHAT_MAILBOX_TTL_MS=15552000000  # 180 days
# RELAY_CHAT_MAILBOX_MAX_FRAMES=5000
# RELAY_CHAT_MAILBOX_MAX_BYTES=268435456 # 256 MiB per account
# Production: require sr25519 account_sig on register_account; chat_fetch/consume need session auth.
# 生产环境：register_account 须 account_sig；chat_fetch/consume 须同会话鉴权。
# RELAY_STRICT_AUTH=1
# Query stats: RELAY_WS=ws://127.0.0.1:8765 npm run relay:admin-stats

# --- Android Capacitor shell (build time only, not Vite) ---
# Remote URL for OTA-friendly APK (see docs/ANDROID.md). Example:
# CAP_SERVER_URL=https://chat.example.com
# Dev on LAN: CAP_SERVER_URL=http://192.168.1.10:5173
# Emulator:   CAP_SERVER_URL=http://10.0.2.2:5173
