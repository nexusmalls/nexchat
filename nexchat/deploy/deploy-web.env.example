# NexChat web deploy — copy to deploy/deploy-web.env (gitignored) and edit.
# One command: npm run deploy:web:remote

# SSH target (user@host)
DEPLOY_SSH=root@151.158.134.181

# Document root on the server (nginx serves https://nexusmall.net/nexchat/)
DEPLOY_REMOTE_PATH=/var/www/nexchat/

# Vite public path (must match nginx location)
DEPLOY_BASE=/nexchat/

# Optional: password auth via sshpass (prefer SSH keys in production)
# DEPLOY_SSHPASS=your-password
# Or export SSHPASS in the shell before deploy.

# rsync excludes (server-only files kept across deploys)
# DEPLOY_RSYNC_EXCLUDES=nexchat.apk,.well-known
