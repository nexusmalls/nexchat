[Unit]
Description=NexChat Relay IPFS backup (encrypt + pin)
After=network.target ipfs.service nexchat-relay.service
Wants=ipfs.service

[Service]
Type=oneshot
User=nexchat
Group=nexchat
EnvironmentFile=/opt/nexchat-relay/relay-backup.env
ExecStart=/opt/nexchat/scripts/relay-backup-to-ipfs.sh
Nice=10

[Install]
WantedBy=multi-user.target
