[Unit]
Description=NexChat WebSocket Relay (Rust relay-rs)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=nexchat
Group=nexchat
WorkingDirectory=/opt/nexchat-relay
Environment=RELAY_DATA_DIR=/opt/nexchat-relay/data
Environment=RELAY_PORT=8765
# Optional: RELAY_ADMIN_SECRET=...
# Optional offline chat mailbox caps (see docs/RELAY_PERSISTENCE.md):
# Environment=RELAY_CHAT_MAILBOX_TTL_MS=15552000000
# Environment=RELAY_CHAT_MAILBOX_MAX_FRAMES=5000
# Environment=RELAY_CHAT_MAILBOX_MAX_BYTES=268435456
# Build: (cd nexchat/relay-rs && cargo build --release -p relay-server) then install the
# Deploy the relay-rs release binary to /opt/nexchat-relay/relay-server-rs.
ExecStart=/opt/nexchat-relay/relay-server-rs
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
